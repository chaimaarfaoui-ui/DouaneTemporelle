<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><layer-list>
        <item android:left="3dp" android:top="4dp"><shape android:shape="rectangle"><solid android:color="#44000000"/><corners android:radius="14dp"/></shape></item>
        <item android:right="3dp" android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="#9A8F7A"/><stroke android:width="3dp" android:color="#5A5040" android:dashWidth="6dp" android:dashGap="4dp"/><corners android:radius="14dp"/></shape></item>
    </layer-list></item>
    <item android:state_pressed="true"><layer-list>
        <item android:left="1dp" android:top="1dp"><shape android:shape="rectangle"><solid android:color="#66000000"/><corners android:radius="14dp"/></shape></item>
        <item android:left="3dp" android:top="3dp"><shape android:shape="rectangle"><solid android:color="#C98A1F"/><stroke android:width="3dp" android:color="@color/ink"/><corners android:radius="14dp"/></shape></item>
    </layer-list></item>
    <item><layer-list>
        <item android:left="4dp" android:top="5dp"><shape android:shape="rectangle"><solid android:color="#99000000"/><corners android:radius="14dp"/></shape></item>
        <item android:right="4dp" android:bottom="5dp"><shape android:shape="rectangle"><solid android:color="@color/mustard"/><stroke android:width="3dp" android:color="@color/ink"/><corners android:radius="14dp"/></shape></item>
    </layer-list></item>
</selector>
