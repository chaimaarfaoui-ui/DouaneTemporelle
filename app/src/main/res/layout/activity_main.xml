<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_main_ca"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_night">

    <!-- نجوم متلألئة في الخلفية -->
    <com.example.douane.TwinkleView
        android:id="@+id/tw_main_ca"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_logo_ca"
                android:layout_width="250dp" android:layout_height="195dp"
                android:scaleType="fitCenter" android:src="@drawable/art_portal"/>

            <TextView
                android:id="@+id/tv_titre_ca"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="casual" android:text="TIME TRAVEL CUSTOMS"
                android:textSize="30sp" android:textStyle="bold" android:textColor="@color/mustard"
                android:shadowColor="@color/red" android:shadowDx="4" android:shadowDy="4" android:shadowRadius="1"
                android:gravity="center" android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="serif-monospace"
                android:text="★ Bureau of Timeline Protection ★"
                android:textSize="12sp" android:textColor="@color/cream" android:gravity="center"/>

            <!-- فقاعة كلام ضابط الجمارك -->
            <TextView
                android:id="@+id/tv_bulle_ca"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:padding="16dp"
                android:background="@drawable/bg_bubble"
                android:fontFamily="casual" android:textSize="15sp" android:textColor="@color/ink"
                android:text="“Halt, traveler! Fill in your papers and the Timeline Police won't have to chase you through the ages.”"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="serif-monospace" android:textStyle="bold"
                    android:text="TRAVELER REGISTRATION · FORM 42-B"
                    android:textSize="12sp" android:textColor="@color/red" android:gravity="center"/>

                <EditText
                    android:id="@+id/et_nom_ca"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="serif-monospace"
                    android:hint="Traveler's name" android:inputType="textPersonName"
                    android:background="@drawable/bg_field" android:padding="14dp"
                    android:textColor="@color/ink" android:textColorHint="#9C8566"/>

                <EditText
                    android:id="@+id/et_naissance_ca"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="serif-monospace"
                    android:hint="Birth year (e.g. 1990)" android:inputType="number"
                    android:maxLength="4"
                    android:background="@drawable/bg_field" android:padding="14dp"
                    android:textColor="@color/ink" android:textColorHint="#9C8566"/>

                <EditText
                    android:id="@+id/et_destination_ca"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="serif-monospace"
                    android:hint="Destination year (or spin the dial)" android:inputType="number"
                    android:maxLength="4"
                    android:background="@drawable/bg_field" android:padding="14dp"
                    android:textColor="@color/ink" android:textColorHint="#9C8566"/>

                <TextView
                    android:id="@+id/tv_machine_titre_ca"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="casual" android:textStyle="bold" android:textSize="16sp"
                    android:text="⚙ THE TIME DIAL — spin to pick a year ⚙"
                    android:textColor="@color/teal"/>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:id="@+id/iv_engrenage1_ca"
                        android:layout_width="46dp" android:layout_height="46dp"
                        android:src="@drawable/ic_gear"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_height="180dp"
                        android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dial" android:padding="4dp">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_annees_ca"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:clipToPadding="false" android:overScrollMode="never"/>
                        <View
                            android:layout_width="match_parent" android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_cadre_annee"/>
                    </FrameLayout>
                    <ImageView
                        android:id="@+id/iv_engrenage2_ca"
                        android:layout_width="46dp" android:layout_height="46dp"
                        android:src="@drawable/ic_gear"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_motif_ca"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="casual" android:textStyle="bold" android:textSize="16sp"
                    android:text="✦ Reason for travelling" android:textColor="@color/teal"/>

                <Spinner
                    android:id="@+id/sp_motif_ca"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field"
                    android:popupBackground="@color/paper"/>

                <Button
                    android:id="@+id/btn_inspecter_ca"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:layout_marginTop="22dp"
                    android:fontFamily="casual" android:text="INSPECTER LE PROFIL ➜"
                    android:background="@drawable/bg_button" android:stateListAnimator="@null"
                    android:textColor="@color/ink" android:textStyle="bold" android:textSize="18sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_historique_titre_ca"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="casual" android:text="★ LOGBOOK OF TRAVELERS ★"
                android:textStyle="bold" android:textSize="16sp" android:textColor="@color/mustard"/>

            <TextView
                android:id="@+id/tv_historique_ca"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
                android:padding="16dp" android:background="@drawable/bg_card"
                android:fontFamily="serif-monospace"
                android:textColor="@color/ink" android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
