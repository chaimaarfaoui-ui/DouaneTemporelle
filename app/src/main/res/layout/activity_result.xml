<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_result_ca"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:id="@+id/fl_scene_ca"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <!-- بوابة زمنية تدور خلف الشخصية -->
        <ImageView
            android:id="@+id/iv_spirale_ca"
            android:layout_width="420dp" android:layout_height="420dp"
            android:layout_gravity="center" android:alpha="0.4"
            android:src="@drawable/art_spiral"/>

        <com.example.douane.TwinkleView
            android:id="@+id/tw_result_ca"
            android:layout_width="match_parent" android:layout_height="match_parent"/>

        <!-- وميض أحمر لسيارة شرطة الزمن عند الرفض -->
        <View
            android:id="@+id/v_sirene_ca"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#66D9482B" android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp">

            <View
                android:id="@+id/v_ruban1_ca"
                android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginStart="-20dp" android:layout_marginEnd="-20dp"
                android:background="@drawable/bg_caution" android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_titre_verdict_ca"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="casual" android:textSize="34sp" android:textStyle="bold"
                android:textColor="@color/mustard" android:gravity="center"
                android:shadowColor="@color/ink" android:shadowDx="4" android:shadowDy="4" android:shadowRadius="1"/>

            <ImageView
                android:id="@+id/iv_photo_ca"
                android:layout_width="230dp" android:layout_height="210dp"
                android:scaleType="fitCenter" android:layout_marginTop="4dp"/>

            <FrameLayout
                android:id="@+id/fl_ticket_ca"
                android:layout_width="300dp" android:layout_height="175dp"
                android:layout_marginTop="2dp" android:layout_marginBottom="10dp">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/img_ticket"/>
                <TextView
                    android:id="@+id/tv_ticket_infos_ca"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="26dp" android:layout_marginBottom="12dp"
                    android:fontFamily="serif-monospace" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="14sp"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_message_ca"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="casual" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@color/cream" android:gravity="center"
                android:shadowColor="@color/ink" android:shadowDx="3" android:shadowDy="3" android:shadowRadius="1"/>

            <TextView
                android:id="@+id/tv_sous_ca"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif-monospace" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/cream" android:gravity="center"/>

            <TextView
                android:id="@+id/tv_tampon_ca"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="36dp" android:layout_marginBottom="22dp"
                android:fontFamily="casual" android:textSize="32sp" android:textStyle="bold"
                android:textColor="@color/cream" android:letterSpacing="0.1"
                android:padding="16dp" android:rotation="-12"/>

            <Button
                android:id="@+id/btn_nouveau_ca"
                android:layout_width="wrap_content" android:layout_height="60dp"
                android:paddingStart="32dp" android:paddingEnd="32dp"
                android:fontFamily="casual" android:text="NOUVEAU VOYAGEUR ➜"
                android:background="@drawable/bg_button" android:stateListAnimator="@null"
                android:textColor="@color/ink" android:textStyle="bold" android:textSize="18sp"/>

            <View
                android:id="@+id/v_ruban2_ca"
                android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginStart="-20dp" android:layout_marginEnd="-20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_caution" android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
