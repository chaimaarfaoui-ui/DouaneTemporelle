<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_result_ca"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">

    <ImageView
        android:id="@+id/iv_photo_ca"
        android:layout_width="180dp" android:layout_height="160dp"
        android:scaleType="fitCenter" android:layout_marginBottom="12dp"/>

    <FrameLayout
        android:id="@+id/fl_ticket_ca"
        android:layout_width="300dp" android:layout_height="175dp"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/img_ticket"/>
        <TextView android:fontFamily="serif"
            android:id="@+id/tv_ticket_infos_ca"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="26dp" android:layout_marginBottom="30dp"
            android:textColor="#3B2414" android:textStyle="bold" android:textSize="14sp"/>
    </FrameLayout>

    <TextView android:fontFamily="serif"
        android:id="@+id/tv_message_ca"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="28sp" android:textStyle="bold"
        android:textColor="#F1E2BC" android:gravity="center"
        android:shadowColor="#000000" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="3"
        android:layout_marginBottom="20dp"/>

    <TextView android:fontFamily="serif"
        android:id="@+id/tv_tampon_ca"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="34sp" android:textStyle="bold" android:textColor="#F1E2BC"
        android:letterSpacing="0.1"
        android:padding="16dp" android:rotation="-12"
        android:background="@drawable/bg_stamp"
        android:layout_marginBottom="24dp"/>

    <Button android:fontFamily="serif"
        android:id="@+id/btn_nouveau_ca"
        android:layout_width="wrap_content" android:layout_height="56dp"
        android:paddingStart="32dp" android:paddingEnd="32dp"
        android:text="Nouveau voyageur"
        android:background="@drawable/bg_button" android:stateListAnimator="@null"
        android:textColor="#2B1810" android:textStyle="bold" android:textSize="16sp"/>
</LinearLayout>
</ScrollView>
