<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="1"
    android:padding="14dp"
    android:background="@drawable/bg_steam">

    <ImageView
        android:id="@+id/img_passeport_ca"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:scaleType="centerInside"
        android:src="@drawable/img_astronaute"/>

    <RelativeLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="@drawable/bg_billet"
        android:padding="16dp">

        <TextView android:fontFamily="serif"
            android:id="@+id/tv_entete_ca"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PASSEPORT TEMPOREL"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="#6B4412" android:letterSpacing="0.08"
            android:layout_alignParentTop="true"/>

        <TextView android:fontFamily="serif"
            android:id="@+id/tv_nom_ca"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_below="@id/tv_entete_ca"
            android:layout_marginTop="16dp" android:textSize="16sp"
            android:textColor="#3B2414"/>

        <TextView android:fontFamily="serif"
            android:id="@+id/tv_age_ca"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_ca"
            android:layout_marginTop="8dp" android:textSize="16sp"
            android:textColor="#3B2414"/>

        <TextView android:fontFamily="serif"
            android:id="@+id/tv_annees_ca"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_ca"
            android:layout_marginTop="8dp" android:textSize="16sp"
            android:textColor="#3B2414"/>

        <TextView android:fontFamily="serif"
            android:id="@+id/tv_motif_ca"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_below="@id/tv_annees_ca"
            android:layout_marginTop="8dp" android:textSize="16sp"
            android:textColor="#3B2414"/>

        <TextView android:fontFamily="serif"
            android:id="@+id/tv_risque_ca"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_below="@id/tv_motif_ca"
            android:layout_marginTop="14dp" android:textSize="15sp"
            android:textColor="#8B1A1A" android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/pb_risque_ca"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_below="@id/tv_risque_ca"
            android:max="100"/>

        <Button android:fontFamily="serif"
            android:id="@+id/btn_refuser_ca"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:text="Refuser (Risque de paradoxe)"
            android:background="@drawable/bg_button_refuse" android:stateListAnimator="@null"
            android:textColor="#8B1A1A" android:textStyle="bold"
            android:textAllCaps="false" android:textSize="13sp"/>

        <Button android:fontFamily="serif"
            android:id="@+id/btn_approuver_ca"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_above="@id/btn_refuser_ca"
            android:layout_marginBottom="10dp"
            android:text="Approuver le saut temporel"
            android:background="@drawable/bg_button" android:stateListAnimator="@null"
            android:textColor="#2B1810" android:textStyle="bold"
            android:textAllCaps="false" android:textSize="13sp"/>
    </RelativeLayout>
</LinearLayout>
